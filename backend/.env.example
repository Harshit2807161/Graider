# Copy to backend/.env for local development (uvicorn/celery run from backend/).

# ===== Security =====
# Required. Generate with `openssl rand -hex 32`
SECRET_KEY=change_this_to_a_secure_random_string
ACCESS_TOKEN_EXPIRE_MINUTES=11520

# First superuser, created by `python -m app.initial_data`
FIRST_SUPERUSER_EMAIL=admin@example.com
FIRST_SUPERUSER_PASSWORD=change_me_please

# ===== Infrastructure =====
DATABASE_URL=postgresql://user:password@localhost:5433/graider
CELERY_BROKER_URL=redis://localhost:6379/0
CELERY_RESULT_BACKEND=redis://localhost:6379/0
UPLOAD_DIR=./data/uploads
MAX_UPLOAD_SIZE_MB=50

# ===== LLM =====
# "openai" or "anthropic"; models must belong to the chosen provider
LLM_PROVIDER=openai
OPENAI_API_KEY=sk-...
ANTHROPIC_API_KEY=sk-ant-api03-...
LLM_VISION_MODEL=gpt-5-nano-2025-08-07
LLM_GRADER_MODEL=gpt-5-nano-2025-08-07
LLM_ORCHESTRATOR_MODEL=gpt-5-nano-2025-08-07
# Runaway-cost guard: max LLM calls for one submission
LLM_MAX_CALLS_PER_SUBMISSION=200

# ===== CORS (JSON list or comma-separated) =====
BACKEND_CORS_ORIGINS=http://localhost:3000,http://127.0.0.1:3000
