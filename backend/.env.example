# Copy to backend/.env for local development (uvicorn/celery run from backend/).

# ===== Security =====
# Required. Generate with `openssl rand -hex 32`
SECRET_KEY=change_this_to_a_secure_random_string
ACCESS_TOKEN_EXPIRE_MINUTES=11520

# First superuser, created by `python -m app.initial_data`
FIRST_SUPERUSER_EMAIL=admin@example.com
FIRST_SUPERUSER_PASSWORD=change_me_please

# ===== Infrastructure =====
DATABASE_URL=postgresql://user:password@localhost:5433/graider
CELERY_BROKER_URL=redis://localhost:6379/0
CELERY_RESULT_BACKEND=redis://localhost:6379/0
UPLOAD_DIR=./data/uploads
MAX_UPLOAD_SIZE_MB=50

# ===== LLM: models per role (see docs/deploy/open-weight.md) =====
# Roles: VISION (OCR), RUBRIC_PARSER, GRADER, EVALUATOR. Each has a primary target and optional
# FALLBACKS (JSON list), tried in order on errors, refusals, truncation or invalid output.
# Providers: anthropic | openai | openweight (self-hosted vLLM/SGLang via OpenAI-compatible API).
# Defaults (nothing set below) = profile A.
ANTHROPIC_API_KEY=sk-ant-api03-...
# OPENAI_API_KEY=sk-...
# OPENWEIGHT_API_KEY=            # only if your vLLM/SGLang server requires a key

# --- Profile A: API only (default) ---
# LLM__VISION__MODEL=claude-opus-5-5
# LLM__RUBRIC_PARSER__MODEL=claude-opus-5-5
# LLM__GRADER__MODEL=claude-sonnet-5-5
# LLM__EVALUATOR__MODEL=claude-opus-5-5

# --- Profile B: hybrid — grader on a self-hosted open-weight model, Claude fallback ---
# LLM__GRADER__PROVIDER=openweight
# LLM__GRADER__MODEL=Qwen/Qwen3-32B
# LLM__GRADER__BASE_URL=http://localhost:8001/v1
# LLM__GRADER__MODEL_REVISION=<hf commit sha>
# LLM__GRADER__QUANTIZATION=fp8
# LLM__GRADER__FALLBACKS=[{"provider":"anthropic","model":"claude-sonnet-5-5","effort":"medium"}]

# --- Profile C: fully local — every role self-hosted, optional Claude fallback ---
# LLM__VISION__PROVIDER=openweight
# LLM__VISION__MODEL=Qwen/Qwen3-VL-8B-Instruct
# LLM__VISION__BASE_URL=http://localhost:8002/v1
# LLM__VISION__FALLBACKS=[{"provider":"anthropic","model":"claude-opus-5-5","effort":"high","max_tokens":16000}]
# LLM__RUBRIC_PARSER__PROVIDER=openweight
# LLM__RUBRIC_PARSER__MODEL=Qwen/Qwen3-32B
# LLM__RUBRIC_PARSER__BASE_URL=http://localhost:8001/v1
# LLM__GRADER__PROVIDER=openweight
# LLM__GRADER__MODEL=Qwen/Qwen3-32B
# LLM__GRADER__BASE_URL=http://localhost:8001/v1
# LLM__EVALUATOR__PROVIDER=openweight
# LLM__EVALUATOR__MODEL=meta-llama/Llama-3.3-70B-Instruct   # a different family than the grader
# LLM__EVALUATOR__BASE_URL=http://localhost:8003/v1

# May a self-hosted primary fall back to an external API (student data leaves your servers)?
# LLM__ALLOW_EXTERNAL_FALLBACK=true
# Runaway-cost guard per submission: calls = BASE + PER_QUESTION * questions, plus a USD cap
# LLM__MAX_CALLS_BASE=20
# LLM__MAX_CALLS_PER_QUESTION=12
# LLM__MAX_COST_USD_PER_SUBMISSION=10

# ===== CORS (JSON list or comma-separated) =====
BACKEND_CORS_ORIGINS=http://localhost:3000,http://127.0.0.1:3000
