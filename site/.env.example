# Copy to .env.local for `npm run dev` / `npm run build`, or set these in the host's build settings.
# All three are read at build time and end up in the static files: never put a secret here.

# Sub-path the site is served under, e.g. /graider. Empty means the domain root.
NEXT_PUBLIC_BASE_PATH=

# The pilot form's Worker endpoint (site/worker). Local: http://localhost:8787/pilot
NEXT_PUBLIC_PILOT_ENDPOINT=

# The Turnstile widget's site key (public). Local: Cloudflare's test key 1x00000000000000000000AA
# Without this or the endpoint, /pilot shows the form with its button disabled and an email line.
NEXT_PUBLIC_TURNSTILE_SITE_KEY=
