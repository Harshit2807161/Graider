# Used by docker-compose (copy to .env at the repo root).
# For running the backend directly, see backend/.env.example.

# Required: sign JWTs. Generate with `openssl rand -hex 32`
SECRET_KEY=change_me

# LLM keys. Model choice per role uses LLM__* variables; every line of this file is passed to
# the backend containers, so the profiles in backend/.env.example work here too.
ANTHROPIC_API_KEY=sk-ant-...
# OPENAI_API_KEY=sk-...
# OPENWEIGHT_API_KEY=

# First superuser, created by `docker compose run --rm backend python -m app.initial_data`
FIRST_SUPERUSER_EMAIL=admin@example.com
FIRST_SUPERUSER_PASSWORD=change_me_please

# Optional: version recorded on every grading run, and MLflow tracing
# (docker compose --profile observability up -d; UI at http://localhost:5001)
# CODE_VERSION=
# MLFLOW_TRACKING_URI=http://mlflow:5000
