# Used by docker-compose (copy to .env at the repo root).
# For running the backend directly, see backend/.env.example.

# Required: sign JWTs. Generate with `openssl rand -hex 32`
SECRET_KEY=change_me

# LLM keys. Model choice per role uses LLM__* variables; every line of this file is passed to
# the backend containers, so the profiles in backend/.env.example work here too.
ANTHROPIC_API_KEY=sk-ant-...
# OPENAI_API_KEY=sk-...
# OPENWEIGHT_API_KEY=

# First superuser, created by `docker compose run --rm backend python -m app.initial_data`
FIRST_SUPERUSER_EMAIL=admin@example.com
FIRST_SUPERUSER_PASSWORD=change_me_please

# Optional: version recorded on every grading run
# CODE_VERSION=

# Optional Langfuse (traces, cost/latency dashboards). Self-hosted, already wired to the worker:
#   docker compose -f docker-compose.yml -f docker-compose.langfuse.yml up -d   (UI: http://localhost:3001)
# Override to use another Langfuse (e.g. Langfuse Cloud EU, https://cloud.langfuse.com):
# LANGFUSE_BASE_URL=
# LANGFUSE_PUBLIC_KEY=
# LANGFUSE_SECRET_KEY=
# For shared/production self-hosting, replace the dev secrets used by docker-compose.langfuse.yml:
# LANGFUSE_SALT= LANGFUSE_ENCRYPTION_KEY= LANGFUSE_NEXTAUTH_SECRET= LANGFUSE_DB_PASSWORD=
# LANGFUSE_CLICKHOUSE_PASSWORD= LANGFUSE_REDIS_PASSWORD= LANGFUSE_MINIO_PASSWORD=
# LANGFUSE_INIT_PROJECT_PUBLIC_KEY= LANGFUSE_INIT_PROJECT_SECRET_KEY= LANGFUSE_INIT_USER_EMAIL= LANGFUSE_INIT_USER_PASSWORD=
